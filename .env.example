# Impasto configuration.
#
# Copy to .env.local and fill in what you need:
#
#   cp .env.example .env.local
#
# Every value below is optional. With none of them set the app runs in demo
# mode against the bundled seed catalog. What differs is whether anything you
# change is kept -- see "Storage modes" at the bottom.
#
# .env.local is git-ignored and must never be committed. This file holds
# placeholders only: do not paste a real key into it.

# ---------------------------------------------------------------------------
# Supabase -- the persistent backend
# ---------------------------------------------------------------------------

# Project URL and anonymous key, from Project Settings -> API.
# Both or neither: one without the other silently falls back to demo mode, and
# the health check reports that as a misconfiguration.
# Safe in the browser: the anon key only ever grants what RLS allows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. This key bypasses Row Level Security completely, so it must
# never be exposed to browser code -- which is why it carries no NEXT_PUBLIC_
# prefix and is only read through serverEnv(), which throws if called in the
# browser. Used by `npm run seed:owner`.
SUPABASE_SERVICE_ROLE_KEY=

# Where the app is reachable. Magic-link emails point here, so without it in
# production the sign-in link goes to localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated list of addresses allowed to sign in. There is no public
# sign-up; an address that is not listed never receives mail.
ALLOWED_EMAILS=

# ---------------------------------------------------------------------------
# Mode
# ---------------------------------------------------------------------------

# Force demo mode even when Supabase credentials are present. Leave empty to
# let the presence of the credentials decide.
DEMO_MODE=

# Where the demo overlay is written. Leave empty to use .impasto-demo/ in the
# project directory. On a serverless platform the bundle is read-only, so set
# this to a writable path (/tmp) to keep data for the life of one instance, or
# leave it unset and accept the read-only demo.
IMPASTO_DEMO_DIR=

# Set to true to force the read-only demo locally, which is how the read-only
# behaviour is exercised in tests.
IMPASTO_DEMO_READONLY=

# ---------------------------------------------------------------------------
# Optional integrations -- each one is a feature that stays off without its key
# ---------------------------------------------------------------------------

# Recipe extraction, label vision and translation.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# YouTube transcripts.
SUPADATA_API_KEY=

# Open Food Facts asks for a real contact address in the User-Agent so they can
# reach whoever is making the requests. Replace the placeholder before using it.
OPENFOODFACTS_USER_AGENT=Impasto/1.0 (you@example.com)

# Web push. Generate a pair with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------------------------------------------------------------------------
# Storage modes, as reported by /api/health
# ---------------------------------------------------------------------------
#
#   mode: "supabase"       Supabase credentials present. Changes persist.
#   mode: "demo"           No Supabase, writable filesystem. Changes are kept
#                          on this machine's disk under IMPASTO_DEMO_DIR.
#   mode: "demo-readonly"  No Supabase and no writable filesystem, e.g. a
#                          Vercel deployment. The catalog is fully browsable
#                          and every write is refused up front.
